# 设置insert模式下C-a/C-e使用emacs风格
set editing-mode vi
set keymap vi-insert
"\C-a": beginning-of-line
"\C-e": end-of-line

# 保持normal模式下vim快捷键不变
set keymap vi-command

# # edit-and-execute-command: \C-x\C-e is coded in emacs mode
# set editing-mode vi
# $if mode=vi
# "\C-x\C-e": edit-and-execute-command
# $endif
